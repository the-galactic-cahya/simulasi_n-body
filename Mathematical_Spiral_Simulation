        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.animation import FuncAnimation\n",
        "from IPython.display import HTML\n",
        "\n",
        "# 1. Hitung semua koordinat langkah terlebih dahulu\n",
        "a = 0\n",
        "b = 0\n",
        "x, y = [0.0], [200.0]\n",
        "angle = 0.0\n",
        "\n",
        "while b < 210:\n",
        "    rad = np.radians(angle)\n",
        "    new_x = x[-1] + a * np.cos(rad)\n",
        "    new_y = y[-1] + a * np.sin(rad)\n",
        "    x.append(new_x)\n",
        "    y.append(new_y)\n",
        "    angle -= b\n",
        "    a += 3\n",
        "    b += 1\n",
        "\n",
        "x = np.array(x)\n",
        "y = np.array(y)\n",
        "\n",
        "# 2. Setup Figure dan Axes untuk Animasi\n",
        "fig, ax = plt.subplots(figsize=(8, 8), facecolor='black')\n",
        "line, = ax.plot([], [], color='white', linewidth=1.5)\n",
        "point, = ax.plot([], [], color='cyan', marker='o', markersize=6)  # Penanda ujung turtle\n",
        "\n",
        "ax.set_facecolor('black')\n",
        "ax.axis('off')\n",
        "\n",
        "# Atur batas koordinat gambar agar pas di tengah\n",
        "padding = 50\n",
        "ax.set_xlim(x.min() - padding, x.max() + padding)\n",
        "ax.set_ylim(y.min() - padding, y.max() + padding)\n",
        "ax.set_aspect('equal')\n",
        "\n",
        "# Fungsi inisialisasi\n",
        "def init():\n",
        "    line.set_data([], [])\n",
        "    point.set_data([], [])\n",
        "    return line, point\n",
        "\n",
        "# Fungsi update per frame\n",
        "def update(frame):\n",
        "    # Menampilkan progres garis sampai langkah ke-frame\n",
        "    line.set_data(x[:frame], y[:frame])\n",
        "    # Menampilkan posisi ujung pena/turtle saat ini\n",
        "    if frame > 0:\n",
        "        point.set_data([x[frame-1]], [y[frame-1]])\n",
        "    return line, point\n",
        "\n",
        "# Buat animasi (kita lompat beberapa frame agar jalannya animasi lebih cepat)\n",
        "step_frames = list(range(1, len(x) + 1, 2))\n",
        "if step_frames[-1] != len(x):\n",
        "    step_frames.append(len(x))\n",
        "\n",
        "ani = FuncAnimation(fig, update, frames=step_frames, init_func=init, blit=True, interval=30)\n",
        "\n",
        "# Tutup plot statis agar tidak muncul ganda\n",
        "plt.close(fig)\n",
        "\n",
        "# Tampilkan animasi interaktif di Google Colab\n",
        "HTML(ani.to_jshtml())\n",
        "\n",
        "# Menyimpan animasi sebagai GIF (memerlukan pustaka pillow)\n",
        "ani.save('spiral_animation.gif', writer='pillow', fps=30)"
      ]
    }
